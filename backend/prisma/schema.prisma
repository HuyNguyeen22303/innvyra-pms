generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "mysql"
}

model Hotel {
  id       BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  code     String      @unique @db.VarChar(50)
  name     String      @db.VarChar(191)
  timezone String      @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  staff    StaffUser[]

  roomTypes    RoomType[]
  rooms        Room[]
  guests       Guest[]
  reservations Reservation[]

  @@map("hotels")
}

model Role {
  id    BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  code  String      @unique @db.VarChar(32)
  name  String      @db.VarChar(100)
  staff StaffUser[]

  @@map("roles")
}

model StaffUser {
  id                    BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId               BigInt         @map("hotel_id") @db.UnsignedBigInt
  roleId                BigInt         @map("role_id") @db.UnsignedBigInt
  fullName              String         @map("full_name") @db.VarChar(191)
  username              String         @unique @db.VarChar(64)
  email                 String?        @unique @db.VarChar(191)
  passwordHash          String         @map("password_hash") @db.VarChar(255)
  isActive              Boolean        @default(true) @map("is_active")
  createdAt             DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  hotel                 Hotel          @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  role                  Role           @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions              AuthSession[]
  createdReservations   Reservation[]  @relation("ReservationCreator")
  cancelledReservations Reservation[]  @relation("ReservationCanceller")
  checkedInStays        Stay[]         @relation("StayCheckinStaff")
  checkedOutStays       Stay[]         @relation("StayCheckoutStaff")
  roomTransfers         RoomTransfer[]

  @@unique([hotelId, id])
  @@index([hotelId])
  @@index([roleId])
  @@map("staff_users")
}

model AuthSession {
  id            String         @id @db.Char(36)
  staffUserId   BigInt         @map("staff_user_id") @db.UnsignedBigInt
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt     DateTime       @map("expires_at") @db.DateTime(3)
  revokedAt     DateTime?      @map("revoked_at") @db.DateTime(3)
  revokedReason String?        @map("revoked_reason") @db.VarChar(32)
  staffUser     StaffUser      @relation(fields: [staffUserId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([staffUserId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id        BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  sessionId String      @map("session_id") @db.Char(36)
  tokenHash String      @unique @map("token_hash") @db.Char(64)
  createdAt DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt DateTime    @map("expires_at") @db.DateTime(3)
  usedAt    DateTime?   @map("used_at") @db.DateTime(3)
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum PhysicalStatus {
  ACTIVE
  OUT_OF_SERVICE
  MAINTENANCE
}

enum HousekeepingStatus {
  DIRTY
  CLEANING
  INSPECTION
  READY
}

model RoomType {
  id               BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId          BigInt            @map("hotel_id") @db.UnsignedBigInt
  code             String            @db.VarChar(30)
  name             String            @db.VarChar(100)
  description      String?           @db.Text
  maxAdults        Int               @map("max_adults") @db.UnsignedSmallInt
  maxChildren      Int               @default(0) @map("max_children") @db.UnsignedSmallInt
  basePrice        Decimal           @map("base_price") @db.Decimal(14, 2)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  hotel            Hotel             @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  rooms            Room[]
  reservationRooms ReservationRoom[]

  // Composite reference enforces hotel isolation even for writes outside the API.
  @@unique([hotelId, id])
  @@unique([hotelId, code])
  @@index([hotelId, isActive])
  @@index([hotelId, name])
  @@index([hotelId, basePrice])
  @@index([hotelId, createdAt])
  @@map("room_types")
}

model Room {
  id                 BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId            BigInt             @map("hotel_id") @db.UnsignedBigInt
  roomTypeId         BigInt             @map("room_type_id") @db.UnsignedBigInt
  roomNumber         String             @map("room_number") @db.VarChar(20)
  floorNumber        Int                @map("floor_number") @db.SmallInt
  physicalStatus     PhysicalStatus     @default(ACTIVE) @map("physical_status")
  housekeepingStatus HousekeepingStatus @default(DIRTY) @map("housekeeping_status")
  notes              String?            @db.Text
  isActive           Boolean            @default(true) @map("is_active")
  createdAt          DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  hotel              Hotel              @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  roomType           RoomType           @relation(fields: [hotelId, roomTypeId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  reservationRooms   ReservationRoom[]
  stays              Stay[]
  occupancy          RoomOccupancy?
  transfersFrom      RoomTransfer[]     @relation("TransferFromRoom")
  transfersTo        RoomTransfer[]     @relation("TransferToRoom")

  @@unique([hotelId, roomTypeId, id])
  @@unique([hotelId, roomNumber])
  @@index([hotelId, roomTypeId])
  @@index([hotelId, floorNumber])
  @@index([hotelId, physicalStatus])
  @@index([hotelId, housekeepingStatus])
  @@index([hotelId, isActive])
  @@index([hotelId, createdAt])
  @@map("rooms")
}

enum GuestGender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum GuestDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVER_LICENSE
  OTHER
}

model Guest {
  id                       BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId                  BigInt             @map("hotel_id") @db.UnsignedBigInt
  fullName                 String             @map("full_name") @db.VarChar(150)
  phone                    String?            @db.VarChar(30)
  email                    String?            @db.VarChar(150)
  dateOfBirth              DateTime?          @map("date_of_birth") @db.Date
  gender                   GuestGender?
  nationality              String?            @db.VarChar(100)
  documentType             GuestDocumentType? @map("document_type")
  documentNumberCiphertext String?            @map("document_number_ciphertext") @db.Text
  documentNumberHash       String?            @map("document_number_hash") @db.Char(64)
  address                  String?            @db.Text
  notes                    String?            @db.Text
  createdAt                DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt                DateTime?          @map("deleted_at") @db.DateTime(3)
  hotel                    Hotel              @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  auditLogs                GuestAuditLog[]
  reservations             Reservation[]

  // Future reservations/stay guests should use this composite reference with RESTRICT.
  // Contact details and document hashes deliberately are NOT unique.
  @@unique([hotelId, id])
  @@index([hotelId, deletedAt, fullName])
  @@index([hotelId, deletedAt, createdAt])
  @@index([hotelId, phone])
  @@index([hotelId, email])
  @@index([hotelId, documentNumberHash])
  @@index([hotelId, nationality])
  @@map("guests")
}

// Stay transitions are server-derived from individual reservation rooms.
enum ReservationStatus {
  CONFIRMED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
  PARTIALLY_CHECKED_IN
}

model Reservation {
  id                 BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId            BigInt            @map("hotel_id") @db.UnsignedBigInt
  confirmationCode   String            @unique @map("confirmation_code") @db.VarChar(32)
  bookerGuestId      BigInt            @map("booker_guest_id") @db.UnsignedBigInt
  checkInDate        DateTime          @map("check_in_date") @db.Date
  checkOutDate       DateTime          @map("check_out_date") @db.Date
  status             ReservationStatus @default(CONFIRMED)
  bookingSource      String            @default("DIRECT") @map("booking_source") @db.VarChar(32)
  totalAmount        Decimal           @map("total_amount") @db.Decimal(14, 2)
  currency           String            @default("VND") @db.Char(3)
  notes              String?           @db.Text
  cancellationReason String?           @map("cancellation_reason") @db.Text
  cancelledAt        DateTime?         @map("cancelled_at") @db.DateTime(3)
  cancelledBy        BigInt?           @map("cancelled_by") @db.UnsignedBigInt
  createdBy          BigInt            @map("created_by") @db.UnsignedBigInt
  createdAt          DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  hotel              Hotel             @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  bookerGuest        Guest             @relation(fields: [hotelId, bookerGuestId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  creator            StaffUser         @relation("ReservationCreator", fields: [hotelId, createdBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  canceller          StaffUser?        @relation("ReservationCanceller", fields: [hotelId, cancelledBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  rooms              ReservationRoom[]

  @@unique([hotelId, id])
  @@index([hotelId, status, checkInDate, checkOutDate])
  @@index([hotelId, bookerGuestId])
  @@index([hotelId, checkInDate])
  @@index([hotelId, checkOutDate])
  @@index([hotelId, bookingSource])
  @@index([hotelId, createdAt])
  @@map("reservations")
}

model ReservationRoom {
  id            BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId       BigInt                 @map("hotel_id") @db.UnsignedBigInt
  reservationId BigInt                 @map("reservation_id") @db.UnsignedBigInt
  roomTypeId    BigInt                 @map("room_type_id") @db.UnsignedBigInt
  // Current (or last, after checkout) assignment. Stay workflows own this field.
  roomId        BigInt?                @map("room_id") @db.UnsignedBigInt
  adults        Int                    @db.UnsignedSmallInt
  children      Int                    @default(0) @db.UnsignedSmallInt
  createdAt     DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  reservation   Reservation            @relation(fields: [hotelId, reservationId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  roomType      RoomType               @relation(fields: [hotelId, roomTypeId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  room          Room?                  @relation(fields: [hotelId, roomTypeId, roomId], references: [hotelId, roomTypeId, id], onDelete: Restrict, onUpdate: Restrict)
  nights        ReservationRoomNight[]
  stay          Stay?

  @@unique([hotelId, roomTypeId, id])
  @@index([hotelId, roomId])
  @@index([hotelId, roomTypeId, reservationId])
  @@map("reservation_rooms")
}

model ReservationRoomNight {
  id                BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  reservationRoomId BigInt          @map("reservation_room_id") @db.UnsignedBigInt
  stayDate          DateTime        @map("stay_date") @db.Date
  nightlyRate       Decimal         @map("nightly_rate") @db.Decimal(14, 2)
  createdAt         DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  reservationRoom   ReservationRoom @relation(fields: [reservationRoomId], references: [id], onDelete: Restrict)

  @@unique([reservationRoomId, stayDate])
  @@index([stayDate, reservationRoomId])
  @@map("reservation_room_nights")
}

model GuestAuditLog {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId       BigInt   @map("hotel_id") @db.UnsignedBigInt
  guestId       BigInt   @map("guest_id") @db.UnsignedBigInt
  actorId       BigInt   @map("actor_id") @db.UnsignedBigInt
  action        String   @db.VarChar(20)
  // Field names only; never before/after values, ciphertext, hashes or request bodies.
  changedFields Json     @map("changed_fields")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  guest         Guest    @relation(fields: [hotelId, guestId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([hotelId, guestId, createdAt])
  @@map("guest_audit_logs")
}

enum StayStatus {
  CHECKED_IN
  CHECKED_OUT
}

model Stay {
  id                BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId           BigInt          @map("hotel_id") @db.UnsignedBigInt
  roomTypeId        BigInt          @map("room_type_id") @db.UnsignedBigInt
  reservationRoomId BigInt          @unique @map("reservation_room_id") @db.UnsignedBigInt
  currentRoomId     BigInt          @map("current_room_id") @db.UnsignedBigInt
  status            StayStatus      @default(CHECKED_IN)
  actualCheckinAt   DateTime        @map("actual_checkin_at") @db.DateTime(3)
  actualCheckoutAt  DateTime?       @map("actual_checkout_at") @db.DateTime(3)
  checkinStaffId    BigInt          @map("checkin_staff_id") @db.UnsignedBigInt
  checkoutStaffId   BigInt?         @map("checkout_staff_id") @db.UnsignedBigInt
  checkinNotes      String?         @map("checkin_notes") @db.VarChar(2000)
  checkoutNotes     String?         @map("checkout_notes") @db.VarChar(2000)
  createdAt         DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  reservationRoom   ReservationRoom @relation(fields: [hotelId, roomTypeId, reservationRoomId], references: [hotelId, roomTypeId, id], onDelete: Restrict, onUpdate: Restrict)
  currentRoom       Room            @relation(fields: [hotelId, roomTypeId, currentRoomId], references: [hotelId, roomTypeId, id], onDelete: Restrict, onUpdate: Restrict)
  checkinStaff      StaffUser       @relation("StayCheckinStaff", fields: [hotelId, checkinStaffId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  checkoutStaff     StaffUser?      @relation("StayCheckoutStaff", fields: [hotelId, checkoutStaffId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  occupancy         RoomOccupancy?
  transfers         RoomTransfer[]

  @@unique([hotelId, roomTypeId, id])
  @@unique([hotelId, roomTypeId, reservationRoomId])
  @@index([hotelId, status, actualCheckinAt])
  @@index([hotelId, actualCheckoutAt])
  @@map("stays")
}

// Only current occupancy is deleted on checkout; Stay and transfers are retained.
model RoomOccupancy {
  roomId     BigInt   @id @map("room_id") @db.UnsignedBigInt
  stayId     BigInt   @unique @map("stay_id") @db.UnsignedBigInt
  hotelId    BigInt   @map("hotel_id") @db.UnsignedBigInt
  roomTypeId BigInt   @map("room_type_id") @db.UnsignedBigInt
  occupiedAt DateTime @map("occupied_at") @db.DateTime(3)
  room       Room     @relation(fields: [hotelId, roomTypeId, roomId], references: [hotelId, roomTypeId, id], onDelete: Restrict, onUpdate: Restrict)
  stay       Stay     @relation(fields: [hotelId, roomTypeId, stayId], references: [hotelId, roomTypeId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([hotelId, roomTypeId, roomId])
  @@unique([hotelId, roomTypeId, stayId])
  @@map("room_occupancies")
}

model RoomTransfer {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId       BigInt    @map("hotel_id") @db.UnsignedBigInt
  roomTypeId    BigInt    @map("room_type_id") @db.UnsignedBigInt
  stayId        BigInt    @map("stay_id") @db.UnsignedBigInt
  fromRoomId    BigInt    @map("from_room_id") @db.UnsignedBigInt
  toRoomId      BigInt    @map("to_room_id") @db.UnsignedBigInt
  transferredAt DateTime  @map("transferred_at") @db.DateTime(3)
  transferredBy BigInt    @map("transferred_by") @db.UnsignedBigInt
  reason        String    @db.VarChar(2000)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  stay          Stay      @relation(fields: [hotelId, roomTypeId, stayId], references: [hotelId, roomTypeId, id], onDelete: Restrict, onUpdate: Restrict)
  fromRoom      Room      @relation("TransferFromRoom", fields: [hotelId, roomTypeId, fromRoomId], references: [hotelId, roomTypeId, id], onDelete: Restrict, onUpdate: Restrict)
  toRoom        Room      @relation("TransferToRoom", fields: [hotelId, roomTypeId, toRoomId], references: [hotelId, roomTypeId, id], onDelete: Restrict, onUpdate: Restrict)
  staff         StaffUser @relation(fields: [hotelId, transferredBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([hotelId, stayId, transferredAt])
  @@map("room_transfers")
}
