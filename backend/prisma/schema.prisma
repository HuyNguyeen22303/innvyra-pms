generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "mysql"
}

model Hotel {
  id       BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  code     String      @unique @db.VarChar(50)
  name     String      @db.VarChar(191)
  timezone String      @default("Asia/Ho_Chi_Minh") @db.VarChar(64)
  staff    StaffUser[]

  roomTypes          RoomType[]
  rooms              Room[]
  guests             Guest[]
  reservations       Reservation[]
  services           Service[]
  billingKeys        BillingIdempotency[]
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
  maintenanceBlocks  MaintenanceBlock[]
  inventoryCategories InventoryCategory[]
  inventoryItems      InventoryItem[]
  suppliers           Supplier[]
  stockReceipts       StockReceipt[]
  stockIssues         StockIssue[]
  stockAdjustments    StockAdjustment[]
  inventoryMovements  InventoryMovement[]

  @@map("hotels")
}

model Role {
  id    BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  code  String      @unique @db.VarChar(32)
  name  String      @db.VarChar(100)
  staff StaffUser[]

  @@map("roles")
}

model StaffUser {
  id                     BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId                BigInt               @map("hotel_id") @db.UnsignedBigInt
  roleId                 BigInt               @map("role_id") @db.UnsignedBigInt
  fullName               String               @map("full_name") @db.VarChar(191)
  username               String               @unique @db.VarChar(64)
  email                  String?              @unique @db.VarChar(191)
  passwordHash           String               @map("password_hash") @db.VarChar(255)
  isActive               Boolean              @default(true) @map("is_active")
  createdAt              DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  hotel                  Hotel                @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  role                   Role                 @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions               AuthSession[]
  createdReservations    Reservation[]        @relation("ReservationCreator")
  cancelledReservations  Reservation[]        @relation("ReservationCanceller")
  checkedInStays         Stay[]               @relation("StayCheckinStaff")
  checkedOutStays        Stay[]               @relation("StayCheckoutStaff")
  roomTransfers          RoomTransfer[]
  createdServiceOrders   ServiceOrder[]       @relation("OrderCreator")
  completedServiceOrders ServiceOrder[]       @relation("OrderCompleter")
  cancelledServiceOrders ServiceOrder[]       @relation("OrderCanceller")
  folioItems             FolioItem[]
  payments               Payment[]
  billingAudits          BillingAuditLog[]
  housekeepingAssigned   HousekeepingTask[]   @relation("HousekeepingAssignee")
  housekeepingCreated    HousekeepingTask[]   @relation("HousekeepingCreator")
  housekeepingInspected  HousekeepingTask[]   @relation("HousekeepingInspector")
  maintenanceReported    MaintenanceTicket[]  @relation("MaintenanceReporter")
  maintenanceAssigned    MaintenanceTicket[]  @relation("MaintenanceAssignee")
  maintenanceResolved    MaintenanceTicket[]  @relation("MaintenanceResolver")
  blocksCreated          MaintenanceBlock[]   @relation("BlockCreator")
  blocksReleased         MaintenanceBlock[]   @relation("BlockReleaser")
  operationsAudits       OperationsAuditLog[]
  createdStockReceipts   StockReceipt[]       @relation("ReceiptCreator")
  createdStockIssues     StockIssue[]         @relation("IssueCreator")
  createdStockAdjustments StockAdjustment[]   @relation("AdjustmentCreator")
  inventoryMovements     InventoryMovement[]  @relation("MovementCreator")

  @@unique([hotelId, id])
  @@index([hotelId])
  @@index([roleId])
  @@map("staff_users")
}

model AuthSession {
  id            String         @id @db.Char(36)
  staffUserId   BigInt         @map("staff_user_id") @db.UnsignedBigInt
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt     DateTime       @map("expires_at") @db.DateTime(3)
  revokedAt     DateTime?      @map("revoked_at") @db.DateTime(3)
  revokedReason String?        @map("revoked_reason") @db.VarChar(32)
  staffUser     StaffUser      @relation(fields: [staffUserId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([staffUserId, revokedAt])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RefreshToken {
  id        BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  sessionId String      @map("session_id") @db.Char(36)
  tokenHash String      @unique @map("token_hash") @db.Char(64)
  createdAt DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  expiresAt DateTime    @map("expires_at") @db.DateTime(3)
  usedAt    DateTime?   @map("used_at") @db.DateTime(3)
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

enum PhysicalStatus {
  ACTIVE
  OUT_OF_SERVICE
  MAINTENANCE
}

enum HousekeepingStatus {
  DIRTY
  CLEANING
  INSPECTION
  READY
}

model RoomType {
  id               BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId          BigInt            @map("hotel_id") @db.UnsignedBigInt
  code             String            @db.VarChar(30)
  name             String            @db.VarChar(100)
  description      String?           @db.Text
  maxAdults        Int               @map("max_adults") @db.UnsignedSmallInt
  maxChildren      Int               @default(0) @map("max_children") @db.UnsignedSmallInt
  basePrice        Decimal           @map("base_price") @db.Decimal(14, 2)
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  hotel            Hotel             @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  rooms            Room[]
  reservationRooms ReservationRoom[]

  // Composite reference enforces hotel isolation even for writes outside the API.
  @@unique([hotelId, id])
  @@unique([hotelId, code])
  @@index([hotelId, isActive])
  @@index([hotelId, name])
  @@index([hotelId, basePrice])
  @@index([hotelId, createdAt])
  @@map("room_types")
}

model Room {
  id                 BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId            BigInt              @map("hotel_id") @db.UnsignedBigInt
  roomTypeId         BigInt              @map("room_type_id") @db.UnsignedBigInt
  roomNumber         String              @map("room_number") @db.VarChar(20)
  floorNumber        Int                 @map("floor_number") @db.SmallInt
  physicalStatus     PhysicalStatus      @default(ACTIVE) @map("physical_status")
  maintenanceManaged Boolean             @default(false) @map("maintenance_managed")
  housekeepingStatus HousekeepingStatus  @default(DIRTY) @map("housekeeping_status")
  notes              String?             @db.Text
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  hotel              Hotel               @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  roomType           RoomType            @relation(fields: [hotelId, roomTypeId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  reservationRooms   ReservationRoom[]
  stays              Stay[]
  occupancy          RoomOccupancy?
  transfersFrom      RoomTransfer[]      @relation("TransferFromRoom")
  transfersTo        RoomTransfer[]      @relation("TransferToRoom")
  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
  maintenanceBlocks  MaintenanceBlock[]

  @@unique([hotelId, id])
  @@unique([hotelId, roomTypeId, id])
  @@unique([hotelId, roomNumber])
  @@index([hotelId, roomTypeId])
  @@index([hotelId, floorNumber])
  @@index([hotelId, physicalStatus])
  @@index([hotelId, housekeepingStatus])
  @@index([hotelId, isActive])
  @@index([hotelId, createdAt])
  @@map("rooms")
}

enum GuestGender {
  MALE
  FEMALE
  OTHER
  UNSPECIFIED
}

enum GuestDocumentType {
  NATIONAL_ID
  PASSPORT
  DRIVER_LICENSE
  OTHER
}

model Guest {
  id                       BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId                  BigInt             @map("hotel_id") @db.UnsignedBigInt
  fullName                 String             @map("full_name") @db.VarChar(150)
  phone                    String?            @db.VarChar(30)
  email                    String?            @db.VarChar(150)
  dateOfBirth              DateTime?          @map("date_of_birth") @db.Date
  gender                   GuestGender?
  nationality              String?            @db.VarChar(100)
  documentType             GuestDocumentType? @map("document_type")
  documentNumberCiphertext String?            @map("document_number_ciphertext") @db.Text
  documentNumberHash       String?            @map("document_number_hash") @db.Char(64)
  address                  String?            @db.Text
  notes                    String?            @db.Text
  createdAt                DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt                DateTime?          @map("deleted_at") @db.DateTime(3)
  hotel                    Hotel              @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  auditLogs                GuestAuditLog[]
  reservations             Reservation[]

  // Future reservations/stay guests should use this composite reference with RESTRICT.
  // Contact details and document hashes deliberately are NOT unique.
  @@unique([hotelId, id])
  @@index([hotelId, deletedAt, fullName])
  @@index([hotelId, deletedAt, createdAt])
  @@index([hotelId, phone])
  @@index([hotelId, email])
  @@index([hotelId, documentNumberHash])
  @@index([hotelId, nationality])
  @@map("guests")
}

// Stay transitions are server-derived from individual reservation rooms.
enum ReservationStatus {
  CONFIRMED
  CANCELLED
  CHECKED_IN
  CHECKED_OUT
  NO_SHOW
  PARTIALLY_CHECKED_IN
}

model Reservation {
  id                 BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  folio              Folio?
  serviceOrders      ServiceOrder[]
  hotelId            BigInt            @map("hotel_id") @db.UnsignedBigInt
  confirmationCode   String            @unique @map("confirmation_code") @db.VarChar(32)
  bookerGuestId      BigInt            @map("booker_guest_id") @db.UnsignedBigInt
  checkInDate        DateTime          @map("check_in_date") @db.Date
  checkOutDate       DateTime          @map("check_out_date") @db.Date
  status             ReservationStatus @default(CONFIRMED)
  bookingSource      String            @default("DIRECT") @map("booking_source") @db.VarChar(32)
  totalAmount        Decimal           @map("total_amount") @db.Decimal(14, 2)
  currency           String            @default("VND") @db.Char(3)
  notes              String?           @db.Text
  cancellationReason String?           @map("cancellation_reason") @db.Text
  cancelledAt        DateTime?         @map("cancelled_at") @db.DateTime(3)
  cancelledBy        BigInt?           @map("cancelled_by") @db.UnsignedBigInt
  createdBy          BigInt            @map("created_by") @db.UnsignedBigInt
  createdAt          DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  hotel              Hotel             @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  bookerGuest        Guest             @relation(fields: [hotelId, bookerGuestId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  creator            StaffUser         @relation("ReservationCreator", fields: [hotelId, createdBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  canceller          StaffUser?        @relation("ReservationCanceller", fields: [hotelId, cancelledBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  rooms              ReservationRoom[]

  @@unique([hotelId, id])
  @@index([hotelId, status, checkInDate, checkOutDate])
  @@index([hotelId, bookerGuestId])
  @@index([hotelId, checkInDate])
  @@index([hotelId, checkOutDate])
  @@index([hotelId, bookingSource])
  @@index([hotelId, createdAt])
  @@map("reservations")
}

model ReservationRoom {
  id            BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId       BigInt                 @map("hotel_id") @db.UnsignedBigInt
  reservationId BigInt                 @map("reservation_id") @db.UnsignedBigInt
  roomTypeId    BigInt                 @map("room_type_id") @db.UnsignedBigInt
  // Current (or last, after checkout) assignment. Stay workflows own this field.
  roomId        BigInt?                @map("room_id") @db.UnsignedBigInt
  adults        Int                    @db.UnsignedSmallInt
  children      Int                    @default(0) @db.UnsignedSmallInt
  createdAt     DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  reservation   Reservation            @relation(fields: [hotelId, reservationId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  roomType      RoomType               @relation(fields: [hotelId, roomTypeId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  room          Room?                  @relation(fields: [hotelId, roomTypeId, roomId], references: [hotelId, roomTypeId, id], onDelete: Restrict, onUpdate: Restrict)
  nights        ReservationRoomNight[]
  stay          Stay?

  @@unique([hotelId, roomTypeId, id])
  @@index([hotelId, roomId])
  @@index([hotelId, roomTypeId, reservationId])
  @@map("reservation_rooms")
}

model ReservationRoomNight {
  id                BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  folioItem         FolioItem?
  reservationRoomId BigInt          @map("reservation_room_id") @db.UnsignedBigInt
  stayDate          DateTime        @map("stay_date") @db.Date
  nightlyRate       Decimal         @map("nightly_rate") @db.Decimal(14, 2)
  createdAt         DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  reservationRoom   ReservationRoom @relation(fields: [reservationRoomId], references: [id], onDelete: Restrict)

  @@unique([reservationRoomId, stayDate])
  @@index([stayDate, reservationRoomId])
  @@map("reservation_room_nights")
}

model GuestAuditLog {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId       BigInt   @map("hotel_id") @db.UnsignedBigInt
  guestId       BigInt   @map("guest_id") @db.UnsignedBigInt
  actorId       BigInt   @map("actor_id") @db.UnsignedBigInt
  action        String   @db.VarChar(20)
  // Field names only; never before/after values, ciphertext, hashes or request bodies.
  changedFields Json     @map("changed_fields")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  guest         Guest    @relation(fields: [hotelId, guestId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([hotelId, guestId, createdAt])
  @@map("guest_audit_logs")
}

enum StayStatus {
  CHECKED_IN
  CHECKED_OUT
}

model Stay {
  id                BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  serviceOrders     ServiceOrder[]
  hotelId           BigInt          @map("hotel_id") @db.UnsignedBigInt
  roomTypeId        BigInt          @map("room_type_id") @db.UnsignedBigInt
  reservationRoomId BigInt          @unique @map("reservation_room_id") @db.UnsignedBigInt
  currentRoomId     BigInt          @map("current_room_id") @db.UnsignedBigInt
  status            StayStatus      @default(CHECKED_IN)
  actualCheckinAt   DateTime        @map("actual_checkin_at") @db.DateTime(3)
  actualCheckoutAt  DateTime?       @map("actual_checkout_at") @db.DateTime(3)
  checkinStaffId    BigInt          @map("checkin_staff_id") @db.UnsignedBigInt
  checkoutStaffId   BigInt?         @map("checkout_staff_id") @db.UnsignedBigInt
  checkinNotes      String?         @map("checkin_notes") @db.VarChar(2000)
  checkoutNotes     String?         @map("checkout_notes") @db.VarChar(2000)
  createdAt         DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  reservationRoom   ReservationRoom @relation(fields: [hotelId, roomTypeId, reservationRoomId], references: [hotelId, roomTypeId, id], onDelete: Restrict, onUpdate: Restrict)
  currentRoom       Room            @relation(fields: [hotelId, roomTypeId, currentRoomId], references: [hotelId, roomTypeId, id], onDelete: Restrict, onUpdate: Restrict)
  checkinStaff      StaffUser       @relation("StayCheckinStaff", fields: [hotelId, checkinStaffId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  checkoutStaff     StaffUser?      @relation("StayCheckoutStaff", fields: [hotelId, checkoutStaffId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  occupancy         RoomOccupancy?
  transfers         RoomTransfer[]

  @@unique([hotelId, roomTypeId, id])
  @@unique([hotelId, roomTypeId, reservationRoomId])
  @@unique([hotelId, id])
  @@index([hotelId, status, actualCheckinAt])
  @@index([hotelId, actualCheckoutAt])
  @@map("stays")
}

// Only current occupancy is deleted on checkout; Stay and transfers are retained.
model RoomOccupancy {
  roomId     BigInt   @id @map("room_id") @db.UnsignedBigInt
  stayId     BigInt   @unique @map("stay_id") @db.UnsignedBigInt
  hotelId    BigInt   @map("hotel_id") @db.UnsignedBigInt
  roomTypeId BigInt   @map("room_type_id") @db.UnsignedBigInt
  occupiedAt DateTime @map("occupied_at") @db.DateTime(3)
  room       Room     @relation(fields: [hotelId, roomTypeId, roomId], references: [hotelId, roomTypeId, id], onDelete: Restrict, onUpdate: Restrict)
  stay       Stay     @relation(fields: [hotelId, roomTypeId, stayId], references: [hotelId, roomTypeId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([hotelId, roomTypeId, roomId])
  @@unique([hotelId, roomTypeId, stayId])
  @@map("room_occupancies")
}

model RoomTransfer {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId       BigInt    @map("hotel_id") @db.UnsignedBigInt
  roomTypeId    BigInt    @map("room_type_id") @db.UnsignedBigInt
  stayId        BigInt    @map("stay_id") @db.UnsignedBigInt
  fromRoomId    BigInt    @map("from_room_id") @db.UnsignedBigInt
  toRoomId      BigInt    @map("to_room_id") @db.UnsignedBigInt
  transferredAt DateTime  @map("transferred_at") @db.DateTime(3)
  transferredBy BigInt    @map("transferred_by") @db.UnsignedBigInt
  reason        String    @db.VarChar(2000)
  createdAt     DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  stay          Stay      @relation(fields: [hotelId, roomTypeId, stayId], references: [hotelId, roomTypeId, id], onDelete: Restrict, onUpdate: Restrict)
  fromRoom      Room      @relation("TransferFromRoom", fields: [hotelId, roomTypeId, fromRoomId], references: [hotelId, roomTypeId, id], onDelete: Restrict, onUpdate: Restrict)
  toRoom        Room      @relation("TransferToRoom", fields: [hotelId, roomTypeId, toRoomId], references: [hotelId, roomTypeId, id], onDelete: Restrict, onUpdate: Restrict)
  staff         StaffUser @relation(fields: [hotelId, transferredBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([hotelId, stayId, transferredAt])
  @@map("room_transfers")
}

enum HousekeepingTaskType {
  TURNOVER_CLEANING
}

enum HousekeepingTaskStatus {
  PENDING
  IN_PROGRESS
  AWAITING_INSPECTION
  COMPLETED
  CANCELLED
}

enum HousekeepingPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MaintenanceTicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum MaintenanceBlockStatus {
  SCHEDULED
  ACTIVE
  RELEASED
  CANCELLED
}

model HousekeepingTask {
  id           BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId      BigInt                 @map("hotel_id") @db.UnsignedBigInt
  roomId       BigInt                 @map("room_id") @db.UnsignedBigInt
  // Nullable unique slot: only nonterminal tasks hold the room. SQL CHECK enforces it.
  activeRoomId BigInt?                @unique @map("active_room_id") @db.UnsignedBigInt
  assignedTo   BigInt?                @map("assigned_to") @db.UnsignedBigInt
  createdBy    BigInt                 @map("created_by") @db.UnsignedBigInt
  taskType     HousekeepingTaskType   @default(TURNOVER_CLEANING) @map("task_type")
  status       HousekeepingTaskStatus @default(PENDING)
  priority     HousekeepingPriority   @default(NORMAL)
  notes        String?                @db.Text
  startedAt    DateTime?              @map("started_at") @db.DateTime(3)
  completedAt  DateTime?              @map("completed_at") @db.DateTime(3)
  inspectedAt  DateTime?              @map("inspected_at") @db.DateTime(3)
  inspectedBy  BigInt?                @map("inspected_by") @db.UnsignedBigInt
  createdAt    DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  hotel        Hotel                  @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  room         Room                   @relation(fields: [hotelId, roomId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  assignee     StaffUser?             @relation("HousekeepingAssignee", fields: [hotelId, assignedTo], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  creator      StaffUser              @relation("HousekeepingCreator", fields: [hotelId, createdBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  inspector    StaffUser?             @relation("HousekeepingInspector", fields: [hotelId, inspectedBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  history      OperationsAuditLog[]

  @@unique([hotelId, id])
  @@index([hotelId, status, priority])
  @@index([hotelId, assignedTo, createdAt])
  @@index([hotelId, roomId, createdAt])
  @@map("housekeeping_tasks")
}

model MaintenanceTicket {
  id              BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId         BigInt                  @map("hotel_id") @db.UnsignedBigInt
  roomId          BigInt                  @map("room_id") @db.UnsignedBigInt
  title           String                  @db.VarChar(200)
  description     String                  @db.Text
  priority        MaintenancePriority     @default(NORMAL)
  status          MaintenanceTicketStatus @default(OPEN)
  reportedBy      BigInt                  @map("reported_by") @db.UnsignedBigInt
  assignedTo      BigInt?                 @map("assigned_to") @db.UnsignedBigInt
  resolvedBy      BigInt?                 @map("resolved_by") @db.UnsignedBigInt
  reportedAt      DateTime                @default(now()) @map("reported_at") @db.DateTime(3)
  startedAt       DateTime?               @map("started_at") @db.DateTime(3)
  resolvedAt      DateTime?               @map("resolved_at") @db.DateTime(3)
  closedAt        DateTime?               @map("closed_at") @db.DateTime(3)
  resolutionNotes String?                 @map("resolution_notes") @db.Text
  createdAt       DateTime                @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.DateTime(3)
  hotel           Hotel                   @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  room            Room                    @relation(fields: [hotelId, roomId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  reporter        StaffUser               @relation("MaintenanceReporter", fields: [hotelId, reportedBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  assignee        StaffUser?              @relation("MaintenanceAssignee", fields: [hotelId, assignedTo], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  resolver        StaffUser?              @relation("MaintenanceResolver", fields: [hotelId, resolvedBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  blocks          MaintenanceBlock[]
  history         OperationsAuditLog[]

  @@unique([hotelId, roomId, id])
  @@unique([hotelId, id])
  @@index([hotelId, status, priority, reportedAt])
  @@index([hotelId, assignedTo, reportedAt])
  @@map("maintenance_tickets")
}

model MaintenanceBlock {
  id                  BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId             BigInt                 @map("hotel_id") @db.UnsignedBigInt
  roomId              BigInt                 @map("room_id") @db.UnsignedBigInt
  maintenanceTicketId BigInt?                @map("maintenance_ticket_id") @db.UnsignedBigInt
  startDate           DateTime               @map("start_date") @db.Date
  endDate             DateTime               @map("end_date") @db.Date
  status              MaintenanceBlockStatus @default(SCHEDULED)
  reason              String                 @db.VarChar(2000)
  createdBy           BigInt                 @map("created_by") @db.UnsignedBigInt
  releasedBy          BigInt?                @map("released_by") @db.UnsignedBigInt
  releasedAt          DateTime?              @map("released_at") @db.DateTime(3)
  createdAt           DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  hotel               Hotel                  @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  room                Room                   @relation(fields: [hotelId, roomId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  ticket              MaintenanceTicket?     @relation(fields: [hotelId, roomId, maintenanceTicketId], references: [hotelId, roomId, id], onDelete: Restrict, onUpdate: Restrict)
  creator             StaffUser              @relation("BlockCreator", fields: [hotelId, createdBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  releaser            StaffUser?             @relation("BlockReleaser", fields: [hotelId, releasedBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  history             OperationsAuditLog[]

  @@unique([hotelId, id])
  @@index([hotelId, roomId, status, startDate, endDate])
  @@index([status, startDate])
  @@map("maintenance_blocks")
}

model OperationsAuditLog {
  id         BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId    BigInt             @map("hotel_id") @db.UnsignedBigInt
  actorId    BigInt             @map("actor_id") @db.UnsignedBigInt
  taskId     BigInt?            @map("task_id") @db.UnsignedBigInt
  ticketId   BigInt?            @map("ticket_id") @db.UnsignedBigInt
  blockId    BigInt?            @map("block_id") @db.UnsignedBigInt
  action     String             @db.VarChar(40)
  fromStatus String?            @map("from_status") @db.VarChar(32)
  toStatus   String             @map("to_status") @db.VarChar(32)
  notes      String?            @db.VarChar(2000)
  createdAt  DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  actor      StaffUser          @relation(fields: [hotelId, actorId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  task       HousekeepingTask?  @relation(fields: [hotelId, taskId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  ticket     MaintenanceTicket? @relation(fields: [hotelId, ticketId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  block      MaintenanceBlock?  @relation(fields: [hotelId, blockId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([hotelId, taskId, createdAt])
  @@index([hotelId, ticketId, createdAt])
  @@index([hotelId, blockId, createdAt])
  @@map("operations_audit_logs")
}

enum ServiceOrderStatus {
  REQUESTED
  COMPLETED
  CANCELLED
}

enum FolioStatus {
  OPEN
  CLOSED
}

enum FolioEntryType {
  DEBIT
  CREDIT
}

enum FolioSourceType {
  ROOM_NIGHT
  SERVICE_ORDER_ITEM
  MANUAL_ADJUSTMENT
}

enum PaymentType {
  PAYMENT
  DEPOSIT
  REFUND
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  CONFIRMED
  PENDING
  FAILED
}

model Service {
  id          BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId     BigInt             @map("hotel_id") @db.UnsignedBigInt
  code        String             @db.VarChar(40)
  name        String             @db.VarChar(150)
  description String?            @db.Text
  unit        String             @db.VarChar(30)
  price       Decimal            @db.Decimal(18, 2)
  isActive    Boolean            @default(true) @map("is_active")
  createdAt   DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  hotel       Hotel              @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  items       ServiceOrderItem[]

  @@unique([hotelId, id])
  @@unique([hotelId, code])
  @@index([hotelId, isActive, name])
  @@map("services")
}

model ServiceOrder {
  id                 BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId            BigInt             @map("hotel_id") @db.UnsignedBigInt
  reservationId      BigInt             @map("reservation_id") @db.UnsignedBigInt
  stayId             BigInt?            @map("stay_id") @db.UnsignedBigInt
  status             ServiceOrderStatus @default(REQUESTED)
  notes              String?            @db.VarChar(2000)
  createdBy          BigInt             @map("created_by") @db.UnsignedBigInt
  completedBy        BigInt?            @map("completed_by") @db.UnsignedBigInt
  completedAt        DateTime?          @map("completed_at") @db.DateTime(3)
  cancelledBy        BigInt?            @map("cancelled_by") @db.UnsignedBigInt
  cancelledAt        DateTime?          @map("cancelled_at") @db.DateTime(3)
  cancellationReason String?            @map("cancellation_reason") @db.VarChar(2000)
  createdAt          DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  reservation        Reservation        @relation(fields: [hotelId, reservationId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  stay               Stay?              @relation(fields: [hotelId, stayId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  creator            StaffUser          @relation("OrderCreator", fields: [hotelId, createdBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  completer          StaffUser?         @relation("OrderCompleter", fields: [hotelId, completedBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  canceller          StaffUser?         @relation("OrderCanceller", fields: [hotelId, cancelledBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  items              ServiceOrderItem[]

  @@unique([hotelId, id])
  @@index([hotelId, reservationId, status])
  @@index([hotelId, createdAt])
  @@map("service_orders")
}

model ServiceOrderItem {
  id                BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId           BigInt       @map("hotel_id") @db.UnsignedBigInt
  serviceOrderId    BigInt       @map("service_order_id") @db.UnsignedBigInt
  serviceId         BigInt       @map("service_id") @db.UnsignedBigInt
  nameSnapshot      String       @map("name_snapshot") @db.VarChar(150)
  unitSnapshot      String       @map("unit_snapshot") @db.VarChar(30)
  quantity          Int          @db.UnsignedInt
  unitPriceSnapshot Decimal      @map("unit_price_snapshot") @db.Decimal(18, 2)
  lineTotal         Decimal      @map("line_total") @db.Decimal(18, 2)
  createdAt         DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  order             ServiceOrder @relation(fields: [hotelId, serviceOrderId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  service           Service      @relation(fields: [hotelId, serviceId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  folioItem         FolioItem?

  @@unique([hotelId, id])
  @@unique([serviceOrderId, serviceId])
  @@map("service_order_items")
}

model Folio {
  id            BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId       BigInt      @map("hotel_id") @db.UnsignedBigInt
  reservationId BigInt      @unique @map("reservation_id") @db.UnsignedBigInt
  currency      String      @default("VND") @db.Char(3)
  status        FolioStatus @default(OPEN)
  openedAt      DateTime    @default(now()) @map("opened_at") @db.DateTime(3)
  closedAt      DateTime?   @map("closed_at") @db.DateTime(3)
  createdAt     DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.DateTime(3)
  reservation   Reservation @relation(fields: [hotelId, reservationId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  items         FolioItem[]
  payments      Payment[]

  @@unique([hotelId, id])
  @@unique([hotelId, reservationId])
  @@index([hotelId, status])
  @@map("folios")
}

model FolioItem {
  id                 BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId            BigInt                @map("hotel_id") @db.UnsignedBigInt
  folioId            BigInt                @map("folio_id") @db.UnsignedBigInt
  entryType          FolioEntryType        @map("entry_type")
  sourceType         FolioSourceType       @map("source_type")
  sourceId           BigInt?               @map("source_id") @db.UnsignedBigInt
  roomNightId        BigInt?               @unique @map("room_night_id") @db.UnsignedBigInt
  serviceOrderItemId BigInt?               @unique @map("service_order_item_id") @db.UnsignedBigInt
  amount             Decimal               @db.Decimal(18, 2)
  description        String                @db.VarChar(2000)
  relatedItemId      BigInt?               @map("related_item_id") @db.UnsignedBigInt
  createdBy          BigInt                @map("created_by") @db.UnsignedBigInt
  createdAt          DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  folio              Folio                 @relation(fields: [hotelId, folioId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  roomNight          ReservationRoomNight? @relation(fields: [roomNightId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  serviceOrderItem   ServiceOrderItem?     @relation(fields: [hotelId, serviceOrderItemId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  relatedItem        FolioItem?            @relation("ItemAdjustment", fields: [hotelId, folioId, relatedItemId], references: [hotelId, folioId, id], onDelete: Restrict, onUpdate: Restrict)
  adjustments        FolioItem[]           @relation("ItemAdjustment")
  creator            StaffUser             @relation(fields: [hotelId, createdBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([hotelId, folioId, id])
  @@unique([hotelId, serviceOrderItemId])
  @@unique([hotelId, sourceType, sourceId])
  @@index([hotelId, folioId, createdAt])
  @@map("folio_items")
}

model Payment {
  id                BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId           BigInt        @map("hotel_id") @db.UnsignedBigInt
  folioId           BigInt        @map("folio_id") @db.UnsignedBigInt
  paymentType       PaymentType   @map("payment_type")
  paymentMethod     PaymentMethod @map("payment_method")
  amount            Decimal       @db.Decimal(18, 2)
  status            PaymentStatus
  referenceNumber   String?       @map("reference_number") @db.VarChar(100)
  originalPaymentId BigInt?       @map("original_payment_id") @db.UnsignedBigInt
  reason            String?       @db.VarChar(2000)
  processedBy       BigInt        @map("processed_by") @db.UnsignedBigInt
  processedAt       DateTime      @default(now()) @map("processed_at") @db.DateTime(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  folio             Folio         @relation(fields: [hotelId, folioId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  processor         StaffUser     @relation(fields: [hotelId, processedBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  originalPayment   Payment?      @relation("PaymentRefund", fields: [hotelId, folioId, originalPaymentId], references: [hotelId, folioId, id], onDelete: Restrict, onUpdate: Restrict)
  refunds           Payment[]     @relation("PaymentRefund")

  @@unique([hotelId, folioId, id])
  @@index([hotelId, folioId, status, createdAt])
  @@map("payments")
}

model BillingIdempotency {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId     BigInt   @map("hotel_id") @db.UnsignedBigInt
  keyHash     String   @map("key_hash") @db.Char(64)
  requestHash String   @map("request_hash") @db.Char(64)
  response    Json
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  hotel       Hotel    @relation(fields: [hotelId], references: [id], onDelete: Restrict)

  @@unique([hotelId, keyHash])
  @@map("billing_idempotency")
}

model BillingAuditLog {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId   BigInt    @map("hotel_id") @db.UnsignedBigInt
  actorId   BigInt    @map("actor_id") @db.UnsignedBigInt
  action    String    @db.VarChar(40)
  entityId  BigInt    @map("entity_id") @db.UnsignedBigInt
  reason    String?   @db.VarChar(2000)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  actor     StaffUser @relation(fields: [hotelId, actorId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([hotelId, action, entityId, createdAt])
  @@map("billing_audit_logs")
}

enum InventoryMovementType {
  RECEIPT
  ISSUE
  ADJUSTMENT
}

model InventoryCategory {
  id          BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId     BigInt          @map("hotel_id") @db.UnsignedBigInt
  code        String          @db.VarChar(50)
  name        String          @db.VarChar(150)
  description String?         @db.Text
  isActive    Boolean         @default(true) @map("is_active")
  createdAt   DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.DateTime(3)
  hotel       Hotel           @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  items       InventoryItem[]

  @@unique([hotelId, id])
  @@unique([hotelId, code])
  @@index([hotelId, isActive])
  @@index([hotelId, name])
  @@map("inventory_categories")
}

model Supplier {
  id            BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId       BigInt         @map("hotel_id") @db.UnsignedBigInt
  code          String         @db.VarChar(50)
  name          String         @db.VarChar(191)
  contactPerson String?        @map("contact_person") @db.VarChar(150)
  phone         String?        @db.VarChar(50)
  email         String?        @db.VarChar(191)
  address       String?        @db.VarChar(255)
  notes         String?        @db.Text
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  hotel         Hotel          @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  receipts      StockReceipt[]

  @@unique([hotelId, id])
  @@unique([hotelId, code])
  @@index([hotelId, isActive])
  @@index([hotelId, name])
  @@map("suppliers")
}

model InventoryItem {
  id            BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId       BigInt              @map("hotel_id") @db.UnsignedBigInt
  categoryId    BigInt              @map("category_id") @db.UnsignedBigInt
  code          String              @db.VarChar(50)
  name          String              @db.VarChar(191)
  unit          String              @db.VarChar(30)
  description   String?             @db.Text
  currentStock  Decimal             @default(0.00) @map("current_stock") @db.Decimal(14, 2)
  minStockLevel Decimal             @default(0.00) @map("min_stock_level") @db.Decimal(14, 2)
  isActive      Boolean             @default(true) @map("is_active")
  createdAt     DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.DateTime(3)
  hotel         Hotel               @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  category      InventoryCategory   @relation(fields: [hotelId, categoryId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  receiptItems  StockReceiptItem[]
  issueItems    StockIssueItem[]
  adjustments   StockAdjustment[]
  movements     InventoryMovement[]

  @@unique([hotelId, id])
  @@unique([hotelId, code])
  @@index([hotelId, categoryId])
  @@index([hotelId, isActive])
  @@index([hotelId, name])
  @@map("inventory_items")
}

model StockReceipt {
  id            BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId       BigInt             @map("hotel_id") @db.UnsignedBigInt
  supplierId    BigInt?            @map("supplier_id") @db.UnsignedBigInt
  receiptNumber String             @map("receipt_number") @db.VarChar(50)
  receiptDate   DateTime           @map("receipt_date") @db.DateTime(3)
  totalAmount   Decimal            @default(0.00) @map("total_amount") @db.Decimal(18, 2)
  notes         String?            @db.Text
  createdBy     BigInt             @map("created_by") @db.UnsignedBigInt
  createdAt     DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  hotel         Hotel              @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  supplier      Supplier?          @relation(fields: [hotelId, supplierId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  creator       StaffUser          @relation("ReceiptCreator", fields: [hotelId, createdBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  items         StockReceiptItem[]

  @@unique([hotelId, id])
  @@unique([hotelId, receiptNumber])
  @@index([hotelId, receiptDate])
  @@index([hotelId, supplierId])
  @@map("stock_receipts")
}

model StockReceiptItem {
  id        BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId   BigInt        @map("hotel_id") @db.UnsignedBigInt
  receiptId BigInt        @map("receipt_id") @db.UnsignedBigInt
  itemId    BigInt        @map("item_id") @db.UnsignedBigInt
  quantity  Decimal       @db.Decimal(14, 2)
  unitPrice Decimal       @default(0.00) @map("unit_price") @db.Decimal(18, 2)
  lineTotal Decimal       @default(0.00) @map("line_total") @db.Decimal(18, 2)
  notes     String?       @db.VarChar(500)
  createdAt DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  receipt   StockReceipt  @relation(fields: [hotelId, receiptId], references: [hotelId, id], onDelete: Cascade, onUpdate: Restrict)
  item      InventoryItem @relation(fields: [hotelId, itemId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([hotelId, id])
  @@index([hotelId, receiptId])
  @@index([hotelId, itemId])
  @@map("stock_receipt_items")
}

model StockIssue {
  id          BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId     BigInt           @map("hotel_id") @db.UnsignedBigInt
  issueNumber String           @map("issue_number") @db.VarChar(50)
  issueDate   DateTime         @map("issue_date") @db.DateTime(3)
  department  String           @db.VarChar(100)
  purpose     String?          @db.VarChar(500)
  notes       String?          @db.Text
  createdBy   BigInt           @map("created_by") @db.UnsignedBigInt
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  hotel       Hotel            @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  creator     StaffUser        @relation("IssueCreator", fields: [hotelId, createdBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  items       StockIssueItem[]

  @@unique([hotelId, id])
  @@unique([hotelId, issueNumber])
  @@index([hotelId, issueDate])
  @@index([hotelId, department])
  @@map("stock_issues")
}

model StockIssueItem {
  id        BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId   BigInt        @map("hotel_id") @db.UnsignedBigInt
  issueId   BigInt        @map("issue_id") @db.UnsignedBigInt
  itemId    BigInt        @map("item_id") @db.UnsignedBigInt
  quantity  Decimal       @db.Decimal(14, 2)
  notes     String?       @db.VarChar(500)
  createdAt DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  issue     StockIssue    @relation(fields: [hotelId, issueId], references: [hotelId, id], onDelete: Cascade, onUpdate: Restrict)
  item      InventoryItem @relation(fields: [hotelId, itemId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([hotelId, id])
  @@index([hotelId, issueId])
  @@index([hotelId, itemId])
  @@map("stock_issue_items")
}

model StockAdjustment {
  id               BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId          BigInt        @map("hotel_id") @db.UnsignedBigInt
  adjustmentNumber String        @map("adjustment_number") @db.VarChar(50)
  itemId           BigInt        @map("item_id") @db.UnsignedBigInt
  systemQuantity   Decimal       @map("system_quantity") @db.Decimal(14, 2)
  actualQuantity   Decimal       @map("actual_quantity") @db.Decimal(14, 2)
  difference       Decimal       @db.Decimal(14, 2)
  reason           String        @db.VarChar(500)
  createdBy        BigInt        @map("created_by") @db.UnsignedBigInt
  createdAt        DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  hotel            Hotel         @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  item             InventoryItem @relation(fields: [hotelId, itemId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  creator          StaffUser     @relation("AdjustmentCreator", fields: [hotelId, createdBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([hotelId, id])
  @@unique([hotelId, adjustmentNumber])
  @@index([hotelId, itemId, createdAt])
  @@map("stock_adjustments")
}

model InventoryMovement {
  id              BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  hotelId         BigInt                @map("hotel_id") @db.UnsignedBigInt
  itemId          BigInt                @map("item_id") @db.UnsignedBigInt
  type            InventoryMovementType
  quantity        Decimal               @db.Decimal(14, 2)
  previousStock   Decimal               @map("previous_stock") @db.Decimal(14, 2)
  currentStock    Decimal               @map("current_stock") @db.Decimal(14, 2)
  referenceType   String                @map("reference_type") @db.VarChar(50)
  referenceId     BigInt?               @map("reference_id") @db.UnsignedBigInt
  referenceNumber String?               @map("reference_number") @db.VarChar(50)
  notes           String?               @db.VarChar(500)
  createdBy       BigInt                @map("created_by") @db.UnsignedBigInt
  createdAt       DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  hotel           Hotel                 @relation(fields: [hotelId], references: [id], onDelete: Restrict)
  item            InventoryItem         @relation(fields: [hotelId, itemId], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)
  creator         StaffUser             @relation("MovementCreator", fields: [hotelId, createdBy], references: [hotelId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([hotelId, id])
  @@index([hotelId, itemId, createdAt])
  @@index([hotelId, type, createdAt])
  @@map("inventory_movements")
}
