NODE_ENV=development
PORT=3000
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/innvyra_pms"
# Optional verified TLS for MySQL (CA PEM file); never disables certificate verification.
DATABASE_SSL=false
DATABASE_SSL_CA_FILE=
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_ISSUER=innvyra-pms
JWT_AUDIENCE=innvyra-pms-api
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7
FRONTEND_URL=http://localhost:5173
# Optional comma-separated additional exact origins; no wildcards.
CORS_ORIGINS=http://localhost:3000
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
# Set an exact trusted hop count only behind a controlled reverse proxy.
TRUST_PROXY_HOPS=0
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=900000
REFRESH_RATE_LIMIT_MAX=60
RESERVATION_MAX_NIGHTS=30
RESERVATION_MAX_ROOMS=20
# Guest document protection: two independent 32-byte random hex keys.
# Generate each separately: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Without both keys, minimal guest profiles work; document reads/writes fail closed (503).
# Keep keys outside source control; do not rotate without re-encrypting/re-indexing existing data.
GUEST_ENCRYPTION_KEY=
GUEST_HASH_KEY=
# Only used by opt-in MySQL tests; local database name must end in _test.
TEST_DATABASE_URL=
# Reports use Hotel.timezone (schema default Asia/Ho_Chi_Minh), never the host timezone.
REPORT_MAX_DAYS=366
REPORT_EXPORT_MAX_ROWS=366
# Demo seed defaults to true outside production; production seeds roles/hotel only.
# Production refuses SEED_DEMO_DATA=true. Set false to skip demo data (staff, rooms, guests, inventory).
# SEED_DEMO_DATA=false
# Optional: override the development demo password (15–128 varied characters).
# SEED_STAFF_PASSWORD=
# If multiple hotels exist, explicitly choose a hotel with both values.
# SEED_HOTEL_CODE=MAIN
# SEED_HOTEL_NAME=Innvyra Hotel
